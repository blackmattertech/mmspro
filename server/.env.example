PORT=5050
HOST=0.0.0.0
# Do NOT use port 5000 on macOS — it conflicts with AirPlay Receiver
# Comma-separated allowed frontend origins (CORS). In dev, LAN IPs on port 5173 are auto-allowed.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Public URL for password-reset and invite links in emails (must be reachable from any device).
# Production: https://your-domain.com
# Dev with ngrok: run `ngrok http 5173`, then paste the https URL here (no trailing slash):
# APP_PUBLIC_URL=https://abc123.ngrok-free.app
APP_PUBLIC_URL=https://your-domain.com

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Only needed for direct DB scripts (optional — wipe uses Supabase CLI instead)
# SUPABASE_DB_PASSWORD=your_database_password

# Firebase Admin (Project Settings → Service Accounts → Generate new private key)
# Option A (recommended): path to the downloaded JSON file (relative to server/)
FIREBASE_SERVICE_ACCOUNT_PATH=./mmspro-c50aa-firebase-adminsdk-fbsvc-43303b0bc4.json
# Option B: paste the entire JSON file contents as a single line instead:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"mmspro-c50aa"}

# Mailjet (transactional email — owner invites, password reset, team invites)
# Get keys: https://app.mailjet.com/account/apikeys
# FROM_EMAIL must be a sender address verified in your Mailjet account
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
MAILJET_FROM_EMAIL=your_verified_sender@yourdomain.com
MAILJET_FROM_NAME=MMS PRO
