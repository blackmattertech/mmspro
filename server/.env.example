PORT=5050
HOST=0.0.0.0
# Do NOT use port 5000 on macOS — it conflicts with AirPlay Receiver
# Comma-separated allowed frontend origins (CORS). In dev, LAN IPs on port 5173 are auto-allowed.
# Vercel: set to your client URL(s), e.g. https://mmspro-client.vercel.app
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Public URL for password-reset and invite links in emails (must be reachable from any device).
# Vercel client URL, e.g. https://mmspro-client.vercel.app (no trailing slash)
# Dev public URL: prefer `npm run tunnel` (Cloudflare) so new visitors skip ngrok's warning page.
# APP_PUBLIC_URL=https://random-name.trycloudflare.com
# Dev with ngrok (shows a first-visit interstitial on the free plan):
# APP_PUBLIC_URL=https://abc123.ngrok-free.app
APP_PUBLIC_URL=https://your-domain.com

# Optional: explicit API URL shown first in Swagger UI servers list
# API_PUBLIC_URL=https://mmspro-server.vercel.app

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Required for applying supabase-patches automatically on server start.
# Dashboard → Project Settings → Database → Database password
# SUPABASE_DB_PASSWORD=your_database_password
# If the password contains @, #, or %, URL-encode it in DATABASE_URL (@ → %40).
# Host is aws-0-<region> or aws-1-<region>.pooler.supabase.com (copy it from the dashboard).
# DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
# SUPABASE_DB_HOST=aws-1-ap-south-1.pooler.supabase.com
# Optional: skip startup migrations
# AUTO_MIGRATE=false

# Firebase Admin (Project Settings → Service Accounts → Generate new private key)
# Vercel / serverless (required): paste the entire JSON file contents as one line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Local dev: path to the downloaded JSON file (relative to server/) instead:
FIREBASE_SERVICE_ACCOUNT_PATH=./mmspro-c50aa-firebase-adminsdk-fbsvc-43303b0bc4.json

# Mailjet (transactional email — owner invites, password reset, team invites)
# Get keys: https://app.mailjet.com/account/apikeys
# FROM_EMAIL must be a sender address verified in your Mailjet account
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
MAILJET_FROM_EMAIL=your_verified_sender@yourdomain.com
MAILJET_FROM_NAME=MMS PRO

# Vercel sets NODE_ENV=production automatically. Do not set PORT/HOST on Vercel.

# Background jobs (task reminders, recurrence, PM generation)
# On always-on hosts (Railway/Render/local), inline timers start by default.
# On Vercel (VERCEL=1), timers stay off — use cron → POST /api/internal/run-jobs instead.
# ENABLE_TASK_SCHEDULER=true
# INTERNAL_JOBS_SECRET=long-random-string

