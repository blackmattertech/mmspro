# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Firebase (Project Settings → General → Your apps → Web app)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Cloud Messaging (Project Settings → Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=your_vapid_key

# Backend API (optional in dev — Vite proxy handles /api automatically)
# Use port 5050 (macOS often reserves 5000 for AirPlay Receiver)
VITE_API_URL=http://localhost:5050
