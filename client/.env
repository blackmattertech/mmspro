# ImageKit — static assets
# URL endpoint from ImageKit dashboard → URL endpoints
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/w2lf8dznx
# Upload mapping:
#   client/public/Assets/images/*  →  ImageKit /images/
#   client/public/Assets/icons/*   →  ImageKit /icons/
#   client/public/Assets/orb.lottie  →  optional: ImageKit /orb.lottie (stays local until uploaded)
# Optional extra prefix if your library uses a parent folder
# VITE_IMAGEKIT_ASSETS_PATH=